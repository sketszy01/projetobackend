{
  "info": {
    "name": "restaurant-ordering-system-API",
    "description": "Execute em ordem em um banco de testes. IDs são capturados dos POSTs. Cria e remove apenas os registros criados nesta execução. Não contém credenciais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health da API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "01 Health da API"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Criar Category e guardar categoryId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories",
        "description": "02 Criar Category e guardar categoryId",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pizzas\",\n  \"description\": \"Pizzas artesanais com diversos sabores.\",\n  \"icon\": \"🍕\",\n  \"display_order\": 1,\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"categoryId\", pm.response.json().id);",
              "pm.test(\"UUID retornado\", () => pm.expect(pm.response.json().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i));"
            ]
          }
        }
      ],
      "response": []
    },
